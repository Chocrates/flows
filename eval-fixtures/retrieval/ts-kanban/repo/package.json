{
  "name": "tackboard",
  "version": "0.4.2",
  "private": true,
  "description": "Self-hosted kanban board with offline editing and live collaboration",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "server": "tsx src/server/app.ts",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.19.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/ws": "^8.5.10",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^1.4.0"
  }
}
